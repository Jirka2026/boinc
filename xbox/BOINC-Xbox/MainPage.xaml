<Page
    x:Class="BOINC_Xbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#101820">

    <Grid Padding="64">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
            <TextBlock
                Text="BOINC Xbox"
                FontSize="56"
                FontWeight="SemiBold"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Xbox Series X Developer Mode port"
                FontSize="24"
                Opacity="0.8"
                HorizontalAlignment="Center" />
            <Border
                Margin="0,26,0,0"
                Padding="28"
                Background="#202A33"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="Platform layer" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="PlatformText" Text="initializing..." FontSize="18" />
                    <TextBlock x:Name="StatusText" Text="starting..." FontSize="18" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
